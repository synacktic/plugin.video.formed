# --- Setting help text -----------------------------------------------------

msgctxt "#30030"
msgid "Shows a short code to approve on your phone or computer. Nothing is typed on the remote."
msgstr ""

msgctxt "#30031"
msgid "Forgets the stored tokens on this device. Your FORMED account is unaffected."
msgstr ""

msgctxt "#30032"
msgid "Leave this off. The default device-code sign-in shows a short code that you approve on your phone, so no password is typed on the remote or stored on this machine. Only turn this on if device sign-in fails."
msgstr ""

msgctxt "#30033"
msgid "Optional. If set, you will only be asked for your password. The password itself is never saved."
msgstr ""

msgctxt "#30034"
msgid "Use the H.264-only stream instead of the multi-codec one. The multi-codec playlist is the usual cause of video that starts fine then stalls or quits after seeking, because the player switches to a rendition the hardware cannot decode. Leave this on unless you have a reason not to."
msgstr ""

msgctxt "#30035"
msgid "Attach subtitle tracks offered by the player. Only used when the stream does not already carry its own subtitles."
msgstr ""

msgctxt "#30036"
msgid "Which language to attach when the add-on supplies subtitles itself. Regional variants match automatically, so English also covers en-US and the auto-generated en-x-autogen track."
msgstr ""

msgctxt "#30037"
msgid "Leave out categories that contain no video once books and audio are filtered out. Costs a few extra requests when a menu is drawn. Turn it off if browsing feels slow."
msgstr ""

msgctxt "#30038"
msgid "Log extra detail about ticket and manifest resolution. Turn this on if playback fails and you need to see where the chain broke."
msgstr ""

